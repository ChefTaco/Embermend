DATABASE_URL=postgresql://embermend:replace-with-generated-password@postgres:5432/embermend
MAGNUS_URL=https://magnus.example.com
MAGNUS_EMBERMEND_TOKEN=replace-with-dedicated-scoped-token
OATHWEAVE_ISSUER=https://identity.example.com
OATHWEAVE_JWKS_URL=https://identity.example.com/api/v1/oauth/jwks
OATHWEAVE_USERINFO_URL=https://identity.example.com/api/v1/oauth/userinfo
# JSON grants bind exact subjects, operation permissions, applications, and targets.
# No wildcard grants. The resource audience is embermend.
EMBERMEND_IDENTITY_GRANTS=[]
EMBERMEND_BIND=127.0.0.1
EMBERMEND_PORT=4180
# Optional GitHub provider broker. Use a dedicated scoped credential and exact grants.
# No provider credential enters a repository sandbox.
# EMBERMEND_GITHUB_TOKEN=configure-through-protected-environment
# EMBERMEND_GITHUB_GRANTS=[{"providerId":"12345","owner":"example-owner","name":"example-app","allowedBranches":["main"],"workflowIds":[]}]
# Optional reviewed OCI publication catalogue; mount it and its layouts read-only.
# Registry credentials remain in the trusted runtime. See docs/ARTIFACT_PUBLICATION.md.
# EMBERMEND_PUBLICATION_CONFIG=/opt/embermend/publication.json
# Optional inference-only broker; runs separately from API and durable worker.
# EMBERMEND_INFERENCE_CONFIG=/opt/embermend/inference.json
# EMBERMEND_INFERENCE_TOKEN=configure-dedicated-random-token-at-least-32-characters
# EMBERMEND_INFERENCE_BIND=127.0.0.1
# EMBERMEND_INFERENCE_PORT=4181
